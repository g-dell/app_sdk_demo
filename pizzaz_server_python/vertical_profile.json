{
  "name": "ApparelVertical",
  "description": "Profilo verticale per prodotti di abbigliamento.",
  "product_attributes": {
    "size": {
      "type": "string",
      "enum": ["XS", "S", "M", "L", "XL"],
      "display_name": "Taglia",
      "filterable": true
    },
    "color": {
      "type": "string",
      "enum": ["Red", "Blue", "Green", "Black", "White"],
      "display_name": "Colore",
      "filterable": true
    },
    "material": {
      "type": "string",
      "enum": ["Cotton", "Polyester", "Wool"],
      "display_name": "Materiale",
      "filterable": true
    },
    "style": {
      "type": "string",
      "display_name": "Stile",
      "filterable": false
    }
  },
  "variant_attributes": {
    "size": {
      "type": "string",
      "enum": ["XS", "S", "M", "L", "XL"],
      "display_name": "Taglia"
    },
    "color": {
      "type": "string",
      "enum": ["Red", "Blue", "Green", "Black", "White"],
      "display_name": "Colore"
    }
  },
  "default_filters": {
    "category_id": "clothing",
    "available": true
  },
  "default_sorts": [
    { "field": "relevance", "direction": "desc" },
    { "field": "price", "direction": "asc" }
  ],
  "product_description_template": "Questo {product.name} in {product.attributes.material} è perfetto per ogni occasione. Disponibile in vari colori e taglie. Colore: {variant.attributes.color}, Taglia: {variant.attributes.size}.",
  "assistant_policy": {
    "tone_of_voice": "Friendly and helpful, expert in fashion.",
    "do_and_donts": [
      "DO recommend complementary items.",
      "DO offer size and fit advice.",
      "DON'T make subjective style judgments.",
      "DON'T provide medical advice."
    ]
  }
}